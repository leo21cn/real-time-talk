# ============================================================
# RealTimeTalk 生产环境变量模板 (.env.production)
# 实际部署请复制本文件为 .env.production.local 并填入真实密钥
# ============================================================

# ── LLM API (OpenAI 兼容 / DashScope) ──────────────────────
LLM_API_KEY=sk-your-llm-api-key-here
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-turbo
LLM_MAX_TOKENS=2048

# ── DashScope TTS ─────────────────────────────────────────────
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
TTS_VOICE=Cherry
TTS_SPEED=1.0

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis_redis:6379/0
REDIS_SESSION_TTL_HOURS=24

# ── MinIO ────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=realtimetalk
MINIO_PRESIGNED_URL_TTL_SECONDS=600

# ── 服务 ──────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://qdrant_qdrant:6333
QDRANT_API_KEY=

# ── Embedding (DashScope 文本嵌入) ────────────────────────────
EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ── RAG ───────────────────────────────────────────────────────
RAG_TOP_K=5
ROLE_COLLECTIONS={"普兰": "pulan_*"}

# ── 知识管理 Admin Token ──────────────────────────────────────
KNOWLEDGE_ADMIN_TOKEN=

# ── FFmpeg ────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFMPEG_GPU_ENCODER=auto
