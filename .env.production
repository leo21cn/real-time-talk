# ============================================================
# RealTimeTalk 生产环境变量 (.env)
# 部署位置: ECS /root/real-time-talk/.env
# 注意: 此文件包含敏感信息，不要提交到版本控制
# ============================================================

# ── LLM API (DashScope) ──────────────────────────────────────
LLM_API_KEY=sk-6d5919bf09be409893953f91a24bffe7
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=2048

# ── DashScope TTS ─────────────────────────────────────────────
DASHSCOPE_API_KEY=sk-6d5919bf09be409893953f91a24bffe7
TTS_VOICE=Cherry
TTS_SPEED=1.0

# ── Redis（复用已有 redis stack，服务名 redis_redis）───────
REDIS_URL=redis://:Shleeyuand1w2!@redis_redis:6379/0
REDIS_SESSION_TTL_HOURS=24

# ── MinIO（同 stack 内 minio 服务）───────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=realtimetalk
MINIO_PRESIGNED_URL_TTL_SECONDS=600

# ── 服务 ──────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Qdrant（复用已有 qdrant stack，服务名 qdrant_qdrant）───
QDRANT_URL=http://qdrant_qdrant:6333
QDRANT_API_KEY=shleeyuan

# ── Embedding (DashScope 文本嵌入) ────────────────────────────
EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ── RAG ───────────────────────────────────────────────────────
RAG_TOP_K=5
ROLE_COLLECTIONS={"普兰": ["pulan-default"]}

# ── 知识管理 Admin Token ──────────────────────────────────────
KNOWLEDGE_ADMIN_TOKEN=km-tk-111111

# ── FFmpeg ────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFMPEG_GPU_ENCODER=auto
