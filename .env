# LLM API 配置
LLM_API_KEY=sk-your-llm-api-key-here
LLM_ENDPOINT=https://api.openai.com/v1
LLM_MODEL=qwen-turbo
LLM_MAX_TOKENS=2048

# DashScope TTS / ASR / Embedding 统一 Key
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
TTS_VOICE=Cherry
TTS_SPEED=1.0

# Redis 配置
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_TTL_HOURS=24

# MinIO 配置
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=realtimetalk
MINIO_PRESIGNED_URL_TTL_SECONDS=600

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Qdrant 向量数据库
QDRANT_URL=http://qdrant:6333

# Embedding（DashScope 文本嵌入）
EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# RAG
RAG_TOP_K=5
ROLE_COLLECTIONS={"普兰": "pulan_*"}

# 知识库管理 Admin Token（留空则跳过鉴权；生产建议填强密码）
KNOWLEDGE_ADMIN_TOKEN=

# FFmpeg 配置
FFMPEG_PATH=ffmpeg
FFMPEG_GPU_ENCODER=auto
